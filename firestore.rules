rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /cart/{cartItemId} {
      // Development-only rule. Add Firebase Authentication before deploying publicly.
      allow read, write: if true;
    }

    match /paidItems/{paidItemId} {
      // Development-only rule. Add Firebase Authentication before deploying publicly.
      allow read, write: if true;
    }
  }
}
